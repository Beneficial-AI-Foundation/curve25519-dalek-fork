/-! # The RFC 9496 §A.3 test vectors for the one-way map (not audited)

Kernel checks (`decide +kernel`) of `Ristretto.fromUniform` on the seven 64-byte inputs of
RFC 9496 §A.3, as little-endian numbers `lo + 2^256 hi`: a regression test of `Ristretto.mapRep`
(both branches of `sqrtRatioM1` occur) and of `Ristretto.encodeRep`. For each half, the output
of `SQRT_RATIO_M1(u, v)` is exhibited as a numeral (`sqrtRatioM1_eq_of_mul_sq_eq`,
`sqrtRatioM1_eq_of_mul_sq_eq_sqrtM1_mul`), the coordinates of `MAP(r₀)` follow from
`mapRep_x`, `mapRep_y` (with `d` as a numeral, `d_eq_natCast`), the sum is computed by the
addition formula, and its encoding is checked as in `Curve25519.Proofs.Ristretto.TestVector`.
`Curve25519.Basic` is imported with `import all` so that the kernel can unfold `p`, `sqrtM1` and
the ristretto255 constants. -/

namespace curve25519.Proofs

open TwistedEdwardsModel Ristretto

/-- `encodeRep` of a point with given coordinates, from the inverse square root `r` of
`(1 + y)(1 - y)(x y)²` as a numeral and a kernel evaluation of the rest. -/
private theorem encodeRep_of_coords {x y r : ZMod p} {n : ℕ} (P : edwards.Point) (hx : P.x = x)
    (hy : P.y = y) (hr : (1 + y) * (1 - y) * (x * y) ^ 2 * r ^ 2 = 1) (hneg : ¬ r.isNeg)
    (hc : (let t := x * y
      let u1 := (1 + y) * (1 - y)
      let u2 := x * y
      let den1 := r * u1
      let den2 := r * u2
      let zInv := den1 * den2 * t
      let ix := x * sqrtM1
      let iy := y * sqrtM1
      let enchanted := den1 * invsqrtAMinusD
      let rotate := (t * zInv).isNeg
      let x' := if rotate then iy else x
      let y' := if rotate then ix else y
      let denInv := if rotate then enchanted else den2
      let y'' := if (x' * zInv).isNeg then -y' else y'
      (denInv * (1 - y'')).abs.val) = n) :
    encodeRep P = n := by
  rw [encodeRep_eq]
  dsimp only
  rw [hx, hy, sqrtRatioM1_one_eq_of_mul_sq_eq hr hneg]
  exact hc

/-- The coordinates of `MAP(r₀)` when `u / v` is a square, from the root `ρ`; `d` as a
numeral. -/
private theorem mapRep_coords_true (r₀ ρ : ZMod p)
    (h : sqrtRatioM1 ((sqrtM1 * r₀ ^ 2 + 1) * oneMinusDSq)
      ((-1 - sqrtM1 * r₀ ^ 2 *
        (37095705934669439343138083508754565189542113879843219016388785533085940283555 : ZMod p))
        * (sqrtM1 * r₀ ^ 2 +
        (37095705934669439343138083508754565189542113879843219016388785533085940283555 : ZMod p)))
      = (true, ρ)) :
    (mapRep r₀).x = 2 * ρ * ((-1 - sqrtM1 * r₀ ^ 2 *
        (37095705934669439343138083508754565189542113879843219016388785533085940283555 : ZMod p))
        * (sqrtM1 * r₀ ^ 2 +
        (37095705934669439343138083508754565189542113879843219016388785533085940283555 : ZMod p)))
      / ((-1 * (sqrtM1 * r₀ ^ 2 - 1) * dMinusOneSq -
        (-1 - sqrtM1 * r₀ ^ 2 *
        (37095705934669439343138083508754565189542113879843219016388785533085940283555 : ZMod p))
          * (sqrtM1 * r₀ ^ 2 +
        (37095705934669439343138083508754565189542113879843219016388785533085940283555 : ZMod p)))
        * sqrtAdMinusOne) ∧
      (mapRep r₀).y = (1 - ρ ^ 2) / (1 + ρ ^ 2) := by
  simp only [mapRep_x, mapRep_y, d_eq_natCast, Nat.cast_ofNat, h, reduceIte, and_self]

/-- The coordinates of `MAP(r₀)` when `u / v` is not a square, from the root `ρ` of `√-1 u / v`;
`d` as a numeral. -/
private theorem mapRep_coords_false (r₀ ρ : ZMod p)
    (h : sqrtRatioM1 ((sqrtM1 * r₀ ^ 2 + 1) * oneMinusDSq)
      ((-1 - sqrtM1 * r₀ ^ 2 *
        (37095705934669439343138083508754565189542113879843219016388785533085940283555 : ZMod p))
        * (sqrtM1 * r₀ ^ 2 +
        (37095705934669439343138083508754565189542113879843219016388785533085940283555 : ZMod p)))
      = (false, ρ)) :
    (mapRep r₀).x = 2 * -(ρ * r₀).abs * ((-1 - sqrtM1 * r₀ ^ 2 *
        (37095705934669439343138083508754565189542113879843219016388785533085940283555 : ZMod p))
        * (sqrtM1 * r₀ ^ 2 +
        (37095705934669439343138083508754565189542113879843219016388785533085940283555 : ZMod p)))
      / ((sqrtM1 * r₀ ^ 2 * (sqrtM1 * r₀ ^ 2 - 1) * dMinusOneSq -
        (-1 - sqrtM1 * r₀ ^ 2 *
        (37095705934669439343138083508754565189542113879843219016388785533085940283555 : ZMod p))
          * (sqrtM1 * r₀ ^ 2 +
        (37095705934669439343138083508754565189542113879843219016388785533085940283555 : ZMod p)))
        * sqrtAdMinusOne) ∧
      (mapRep r₀).y = (1 - (-(ρ * r₀).abs) ^ 2) / (1 + (-(ρ * r₀).abs) ^ 2) := by
  simp only [mapRep_x, mapRep_y, d_eq_natCast, Nat.cast_ofNat, h, Bool.false_eq_true, reduceIte,
    and_self]

