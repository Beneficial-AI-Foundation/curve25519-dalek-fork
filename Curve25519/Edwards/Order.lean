module
public import Curve25519.Edwards.Basepoint
public import Curve25519.Edwards.Torsion
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.NormNum
public section

/-! # The group of points of curve25519

`edwards.Point` is finite of cardinality `8 L` (`card_point`), cyclic, generated by
`torsion8 + basepoint` of order `8 L`, and every point decomposes uniquely as
`eightTorsion i + n • basepoint` with `i < 8`, `n < L` (`exists_unique_decomposition`): the
8-torsion is `{eightTorsion i}` (`eight_nsmul_eq_zero_iff`) and the prime-order subgroup is
`{n • basepoint}` (`L_nsmul_eq_zero_iff`). The cardinality is pinned from above by the injection
`P ↦ (y, parity of x)` into `ZMod p × Bool` (`card_point_le`, so `card ≤ 2 p < 16 L`) and from
below by `8 L ∣ card` (Lagrange, for `torsion8 + basepoint`). The same cardinality holds for
`curve.Point` and `montgomery.Point` (`card_curve`, `card_montgomery`). -/

namespace curve25519

open TwistedEdwardsModel

/-! ### Finiteness and the cardinality bound -/

instance instFiniteEdwardsPoint : Finite edwards.Point :=
  Finite.of_injective (fun P : edwards.Point => (P.x, P.y)) fun _ _ h =>
    Point.ext (congrArg Prod.fst h) (congrArg Prod.snd h)

@[no_expose] noncomputable instance instFintypeEdwardsPoint : Fintype edwards.Point :=
  Fintype.ofFinite _

/-- `a - d y² ≠ 0` for every `y`, since `a / d` is not a square. -/
private theorem a_sub_d_mul_sq_ne_zero (y : ZMod p) : a - d * y ^ 2 ≠ 0 := by
  intro h
  have hy : y ≠ 0 := by
    rintro rfl
    rw [a_def] at h
    norm_num at h
  apply not_isSquare_d
  refine ⟨(sqrtM1 : ZMod p) / y, ?_⟩
  rw [div_mul_div_comm, eq_div_iff (mul_ne_zero hy hy)]
  rw [a_def] at h
  linear_combination -h - sqrtM1_sq

/-- Two points with the same `y` have the same `x²`. -/
theorem sq_x_eq_of_y_eq {P Q : edwards.Point} (h : P.y = Q.y) : P.x ^ 2 = Q.x ^ 2 := by
  have hP := P.equation
  have hQ := Q.equation
  unfold Equation at hP hQ
  rw [edwards_a, edwards_d] at hP hQ
  rw [h] at hP
  have key : (a - d * Q.y ^ 2) * (P.x ^ 2 - Q.x ^ 2) = 0 := by linear_combination hP - hQ
  exact sub_eq_zero.mp ((mul_eq_zero.mp key).resolve_left (a_sub_d_mul_sq_ne_zero Q.y))

/-- Two points with the same `y` have `x' = x` or `x' = -x`. -/
theorem x_eq_or_x_eq_neg_of_y_eq {P Q : edwards.Point} (h : P.y = Q.y) :
    P.x = Q.x ∨ P.x = -Q.x :=
  sq_eq_sq_iff_eq_or_eq_neg.mp (sq_x_eq_of_y_eq h)

/-- `P ↦ (y, parity of x)` is injective: `x` and `-x` have different parities when `x ≠ 0`,
since `p` is odd. -/
private theorem parity_injective :
    Function.Injective fun P : edwards.Point => (P.y, decide (P.x.val % 2 = 1)) := by
  intro P Q h
  simp only [Prod.mk.injEq] at h
  obtain ⟨hy, hpar⟩ := h
  refine Point.ext ?_ hy
  rcases x_eq_or_x_eq_neg_of_y_eq hy with hx | hx
  · exact hx
  · by_cases hQ : Q.x = 0
    · rw [hx, hQ, neg_zero]
    · exfalso
      rw [decide_eq_decide, hx, ZMod.neg_val, ite_eq_right hQ] at hpar
      have h1 := ZMod.val_lt Q.x
      have h2 : Q.x.val ≠ 0 := fun h0 => hQ ((ZMod.val_eq_zero _).mp h0)
      have h3 := p_mod_two
      omega

/-- At most `2 p` points: at most two for each `y`. -/
theorem card_point_le : Fintype.card edwards.Point ≤ 2 * p := by
  have h := Fintype.card_le_of_injective _ parity_injective
  rwa [Fintype.card_prod, ZMod.card, Fintype.card_bool, mul_comm] at h

/-! ### The cardinality -/

theorem coprime_eight_L : Nat.Coprime 8 L := by
  have h2 : Nat.Coprime 2 L :=
    (Nat.coprime_primes Nat.prime_two L_prime).mpr
      (ne_of_lt (lt_trans (by norm_num) two_pow_252_lt_L))
  exact h2.pow_left 3

/-- `torsion8 + basepoint` has order `8 L`. -/
theorem addOrderOf_torsion8_add_basepoint : addOrderOf (torsion8 + basepoint) = 8 * L := by
  rw [(AddCommute.all torsion8 basepoint).addOrderOf_add_eq_mul_addOrderOf_of_coprime
    (by rw [addOrderOf_torsion8, addOrderOf_basepoint]; exact coprime_eight_L),
    addOrderOf_torsion8, addOrderOf_basepoint]

theorem eight_mul_L_dvd_card : 8 * L ∣ Fintype.card edwards.Point :=
  addOrderOf_torsion8_add_basepoint ▸ addOrderOf_dvd_card

theorem two_mul_p_lt_sixteen_mul_L : 2 * p < 16 * L := by
  have h1 := p_lt_two_pow_255
  have h2 := two_pow_252_lt_L
  have h3 : (2 : ℕ) ^ 255 = 8 * 2 ^ 252 := by norm_num
  omega

/-- **The cardinality**: `edwards.Point` has `8 L` elements. -/
theorem card_point : Fintype.card edwards.Point = 8 * L := by
  obtain ⟨k, hk⟩ := eight_mul_L_dvd_card
  have hle := card_point_le
  have hlt := two_mul_p_lt_sixteen_mul_L
  have hpos : 0 < Fintype.card edwards.Point := Fintype.card_pos
  rcases k with _ | _ | k
  · rw [hk, mul_zero] at hpos
    exact absurd hpos (lt_irrefl 0)
  · rw [hk, zero_add, mul_one]
  · exfalso
    rw [hk] at hle
    have h16 : 8 * L * 2 ≤ 8 * L * (k + 1 + 1) := Nat.mul_le_mul_left _ (by omega)
    omega

/-- Every point is killed by `8 L`. -/
theorem eight_mul_L_nsmul (P : edwards.Point) : (8 * L) • P = 0 :=
  card_point ▸ card_nsmul_eq_zero

/-- The group of points is cyclic, generated by `torsion8 + basepoint`. -/
theorem isAddCyclic : IsAddCyclic edwards.Point :=
  isAddCyclic_of_addOrderOf_eq_card _
    (addOrderOf_torsion8_add_basepoint.trans (card_point.symm.trans Nat.card_eq_fintype_card.symm))

/-! ### The decomposition `ℤ/8 × ℤ/L` -/

/-- `(i, n) ↦ eightTorsion i + n • basepoint`. -/
private noncomputable def decomp (q : Fin 8 × Fin L) : edwards.Point :=
  eightTorsion q.1 + (q.2 : ℕ) • basepoint

/-- `5 L ≡ 1 (mod 8)`, so `(5 L) • torsion8 = torsion8`. -/
private theorem five_mul_L_nsmul_torsion8 : (5 * L) • torsion8 = torsion8 := by
  rw [← mod_addOrderOf_nsmul, addOrderOf_torsion8]
  have h : 5 * L % 8 = 1 := by rw [L_eq_numeral]
  rw [h, one_nsmul]

private theorem five_mul_L_nsmul_basepoint : (5 * L) • basepoint = 0 := by
  rw [← smul_smul, L_nsmul_basepoint, smul_zero]

private theorem decomp_injective : Function.Injective decomp := by
  rintro ⟨i, n⟩ ⟨i', n'⟩ h
  change eightTorsion i + (n : ℕ) • basepoint = eightTorsion i' + (n' : ℕ) • basepoint at h
  have h5 : (5 * L) • (eightTorsion i + (n : ℕ) • basepoint) =
      (5 * L) • (eightTorsion i' + (n' : ℕ) • basepoint) := by
    rw [h]
  rw [smul_add, smul_add, eightTorsion_apply, eightTorsion_apply, smul_comm (5 * L) (i : ℕ),
    smul_comm (5 * L) (i' : ℕ), smul_comm (5 * L) (n : ℕ), smul_comm (5 * L) (n' : ℕ),
    five_mul_L_nsmul_torsion8, five_mul_L_nsmul_basepoint, smul_zero, smul_zero, add_zero, add_zero,
    ← eightTorsion_apply, ← eightTorsion_apply] at h5
  obtain rfl := eightTorsion_injective h5
  have hn : (n : ℕ) • basepoint = (n' : ℕ) • basepoint := add_left_cancel h
  rw [nsmul_eq_nsmul_iff_modEq, addOrderOf_basepoint] at hn
  rw [Fin.ext (hn.eq_of_lt_of_lt n.isLt n'.isLt)]

private theorem decomp_bijective : Function.Bijective decomp :=
  (Fintype.bijective_iff_injective_and_card decomp).mpr ⟨decomp_injective, by
    rw [Fintype.card_prod, Fintype.card_fin, Fintype.card_fin, card_point]⟩

/-- **The decomposition**: every point is uniquely `eightTorsion i + n • basepoint` with `i < 8`
and `n < L`. -/
theorem exists_unique_decomposition (P : edwards.Point) :
    ∃! q : Fin 8 × Fin L, P = eightTorsion q.1 + (q.2 : ℕ) • basepoint := by
  obtain ⟨q, hq, huniq⟩ := decomp_bijective.existsUnique P
  exact ⟨q, hq.symm, fun q' hq' => huniq q' hq'.symm⟩

/-- The 8-torsion is `{eightTorsion i}`. -/
theorem eight_nsmul_eq_zero_iff (P : edwards.Point) :
    8 • P = 0 ↔ ∃ i : Fin 8, P = eightTorsion i := by
  constructor
  · intro h
    obtain ⟨⟨i, n⟩, hq, -⟩ := exists_unique_decomposition P
    refine ⟨i, ?_⟩
    rw [hq] at h ⊢
    rw [smul_add, eight_nsmul_eightTorsion, zero_add, smul_smul] at h
    have hL : L ∣ 8 * n := by
      have hd := addOrderOf_dvd_of_nsmul_eq_zero h
      rwa [addOrderOf_basepoint] at hd
    have hn : (n : ℕ) = 0 :=
      Nat.eq_zero_of_dvd_of_lt (coprime_eight_L.symm.dvd_of_dvd_mul_left hL) n.isLt
    rw [hn, zero_nsmul, add_zero]
  · rintro ⟨i, rfl⟩
    exact eight_nsmul_eightTorsion i

/-- The prime-order subgroup is `{n • basepoint}`. -/
theorem L_nsmul_eq_zero_iff (P : edwards.Point) : L • P = 0 ↔ ∃ n : ℕ, P = n • basepoint := by
  constructor
  · intro h
    obtain ⟨⟨i, n⟩, hq, -⟩ := exists_unique_decomposition P
    refine ⟨n, ?_⟩
    rw [hq] at h ⊢
    rw [smul_add, eightTorsion_apply, smul_comm L (i : ℕ), smul_comm L (n : ℕ),
      L_nsmul_basepoint, smul_zero, add_zero, smul_smul] at h
    have h8 : 8 ∣ i * L := by
      have hd := addOrderOf_dvd_of_nsmul_eq_zero h
      rwa [addOrderOf_torsion8] at hd
    have hi : (i : ℕ) = 0 :=
      Nat.eq_zero_of_dvd_of_lt (coprime_eight_L.dvd_of_dvd_mul_right h8) i.isLt
    rw [eightTorsion_apply, hi, zero_nsmul, zero_add]
  · rintro ⟨n, rfl⟩
    rw [smul_comm, L_nsmul_basepoint, smul_zero]

/-! ### The curve and the Montgomery model -/

/-- The curve has `8 L` points. -/
theorem card_curve : Fintype.card curve.Point = 8 * L := by
  rw [← toCurve_edwards, ← Fintype.card_congr edwards.pointEquiv.toEquiv, card_point]

instance instFiniteMontgomeryPoint : Finite montgomery.Point :=
  Finite.of_equiv _ montgomery.pointEquiv.symm.toEquiv

@[no_expose] noncomputable instance instFintypeMontgomeryPoint : Fintype montgomery.Point :=
  Fintype.ofFinite _

/-- The Montgomery model has `8 L` points. -/
theorem card_montgomery : Fintype.card montgomery.Point = 8 * L := by
  rw [Fintype.card_congr montgomery.pointEquiv.toEquiv, toCurve_montgomery, card_curve]

end curve25519
