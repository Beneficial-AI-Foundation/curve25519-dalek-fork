/-- The kernel check of `oddMultiplesCoords`. -/
private theorem oddMultiplesCoords_check : ∀ k, 0 ≤ k → k < 64 →
    edwards.Equation ((oddMultiplesCoords[k]!.1 : ℕ) : ZMod p) (oddMultiplesCoords[k]!.2 : ℕ) ∧
    (Extended.nsmul (2 * k + 1) (basepointExt edwards)).ProjEq ⟨(oddMultiplesCoords[k]!.1 : ℕ),
      (oddMultiplesCoords[k]!.2 : ℕ), 1, ((oddMultiplesCoords[k]!.1 : ℕ) : ZMod p) * (oddMultiplesCoords[k]!.2 : ℕ)⟩ := by
  rw [edwards_eq']
  decide +kernel

/-- The kernel check of `oddMultiples128Coords`. -/
private theorem oddMultiples128Coords_check : ∀ k, 0 ≤ k → k < 8 →
    edwards.Equation ((oddMultiples128Coords[k]!.1 : ℕ) : ZMod p) (oddMultiples128Coords[k]!.2 : ℕ) ∧
    (Extended.nsmul ((2 * k + 1) * 2 ^ 128) (basepointExt edwards)).ProjEq ⟨(oddMultiples128Coords[k]!.1 : ℕ),
      (oddMultiples128Coords[k]!.2 : ℕ), 1, ((oddMultiples128Coords[k]!.1 : ℕ) : ZMod p) * (oddMultiples128Coords[k]!.2 : ℕ)⟩ := by
  rw [edwards_eq']
  decide +kernel

/-- The coordinates of `(2 k + 1) • B` for `k < 64` (dalek's `AFFINE_ODD_MULTIPLES_OF_BASEPOINT`). -/
theorem oddMultiplesCoords_spec (k : ℕ) (hk : k < 64) :
    ((2 * k + 1) • basepoint).x = (oddMultiplesCoords[k]!.1 : ℕ) ∧
      ((2 * k + 1) • basepoint).y = (oddMultiplesCoords[k]!.2 : ℕ) :=
  nsmul_basepoint_of_check (oddMultiplesCoords_check k (Nat.zero_le k) hk)

/-- The coordinates of `(2 k + 1) • 2^128 • B` for `k < 8` (dalek's
`AFFINE_ODD_MULTIPLES_OF_BASEPOINT_128`). -/
theorem oddMultiples128Coords_spec (k : ℕ) (hk : k < 8) :
    ((2 * k + 1) • 2 ^ 128 • basepoint).x = (oddMultiples128Coords[k]!.1 : ℕ) ∧
      ((2 * k + 1) • 2 ^ 128 • basepoint).y = (oddMultiples128Coords[k]!.2 : ℕ) := by
  rw [smul_smul]
  exact nsmul_basepoint_of_check (oddMultiples128Coords_check k (Nat.zero_le k) hk)

